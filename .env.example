# Browser: only public Supabase credentials belong here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project

# Backend-only: set through Supabase Secrets; NEVER prefix these with VITE_.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=http://127.0.0.1:8080
# ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase.
